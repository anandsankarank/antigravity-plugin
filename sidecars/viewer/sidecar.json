{
  "command": "node",
  "args": ["server.mjs"],
  "restart_policy": "always",
  "display_name": "A-MDUI Studio",
  "description": "Live preview and interactive explorer for A-MDUI documents in Antigravity",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": true
  },
  "ui_config": {
    "display_name": "A-MDUI Studio",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "A-MDUI Studio"
      }
    ]
  }
}

